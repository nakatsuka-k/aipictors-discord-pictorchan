{
  "name": "pictorchan-bot",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "account_id": "7f2a200bf2994f36f45e733751a30be6",
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "vars": {
    "CONTAINER_ENV_KEYS": "BUG_CH_ID,CLIENT_ID,DISCORD_BOT_API_TOKEN,DISCORD_TOKEN,GH_OWNER,GH_REPO,GH_TOKEN,GROK_API_KEY,GEMINI_API_KEY,GEMINI_CHAT,GEMINI_CHAT_MODEL,NODE_ENV,OPINION_CH_ID,STATE_URL,ADMIN_TOKEN",
    "CONTAINER_INSTANCE": "basic",
    "STATE_URL": "https://pictorchan-bot.aipictors.workers.dev"
  },
  "r2_buckets": [
    {
      "binding": "STATE",
      "bucket_name": "pictorchan-state"
    }
  ],
  // 画像の縮小（Cloudflare Images）と動画のコマ切り出し（Media Transformations）
  "images": {
    "binding": "IMAGES"
  },
  "media": {
    "binding": "MEDIA"
  },
  // 前の Container 版（戻すとき用。普段は止めてある）。イメージは最後に使っていたものを digest で固定
  "containers": [
    {
      "class_name": "Runner",
      "scheduling_policy": "durable_object",
      "images": {
        "base": {
          "image": "registry.cloudflare.com/7f2a200bf2994f36f45e733751a30be6/pictorchan-bot-runner-base@sha256:4c9cf9d6a1075b61624b082c1e63169d6681222cb706ef1ee856220ba67c2016"
        }
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "RUNNER",
        "class_name": "Runner"
      },
      {
        "name": "BOT",
        "class_name": "Bot"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "Runner"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "Bot"
      ]
    }
  ]
}
